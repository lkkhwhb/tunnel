# Required
TUNNEL_API_KEY=your-api-key-here

# Server
HOST=0.0.0.0
PORT=5000
ENVIRONMENT=production

# Logging (stdout only — optimized for cloud platforms)
LOG_LEVEL=INFO
LOG_SAMPLE_RATE=100
LOG_FORMAT=json

# Timeouts
TUNNEL_TIMEOUT=30
PING_INTERVAL=15
PING_TIMEOUT=45

# Streaming
STREAMING_THRESHOLD_BYTES=1048576
CHUNK_SIZE=32768

# Rate Limiting
RATE_LIMIT_DEFAULT=500 per minute

# Tunnel Ban (seconds to block re-registration after admin force-disconnect)
TUNNEL_BAN_DURATION=300

# Gunicorn (production)
WEB_CONCURRENCY=5
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
